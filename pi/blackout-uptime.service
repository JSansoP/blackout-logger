[Unit]
Description=Blackout Logger — Uptime Server
Documentation=https://github.com/your-user/blackout-logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/blackout-logger
ExecStart=/usr/bin/python3 /home/pi/blackout-logger/uptime_server.py --port 8080
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blackout-uptime

[Install]
WantedBy=multi-user.target
