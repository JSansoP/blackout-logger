# Blackout Logger — Configuration
# Copy this file to .env at the project root and fill in the values.

# ── Raspberry Pi Connection ──────────────────────────────────
# Tailscale IP address of the Raspberry Pi
PI_ADDRESS=100.x.x.x

# Port the uptime server listens on (default: 8080)
PI_PORT=8080

# Timeout in seconds when polling the Pi (default: 10)
POLL_TIMEOUT=10

# ── Retry Loop ───────────────────────────────────────────────
# Seconds between retries when Pi is unreachable (default: 60)
RETRY_INTERVAL=60

# Max seconds to stay in the retry loop before exiting (default: 3600)
# The next cron run will pick up monitoring if this is exceeded.
MAX_RETRY_DURATION=3600

# ── Database ─────────────────────────────────────────────────
# Path to the SQLite database file (default: ./blackout.db)
# DB_PATH=./blackout.db

# ── Telegram Notifications ───────────────────────────────────
# Create a bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Chat ID or Channel ID to send notifications to
# You can get this by sending a message to your bot and checking:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your-chat-id-here

# ── Lock File ────────────────────────────────────────────────
# Path to the PID lock file (default: /tmp/blackout_checker.lock)
# LOCK_FILE=/tmp/blackout_checker.lock
